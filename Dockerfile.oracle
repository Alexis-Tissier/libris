FROM node:22-bookworm-slim AS frontend
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html vite.config.ts tsconfig.json tsconfig.node.json ./
COPY src ./src
RUN npm run build

FROM rust:1.88-bookworm AS backend
WORKDIR /src
COPY server ./server
COPY src-tauri/src ./src-tauri/src
RUN cd server && cargo build --release

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=backend /src/server/target/release/libris-server /usr/local/bin/libris-server
COPY --from=frontend /src/dist /app/dist
ENV LIBRIS_BIND=0.0.0.0:8030 \
    LIBRIS_DIST_DIR=/app/dist \
    XDG_DATA_HOME=/data
EXPOSE 8030
CMD ["libris-server"]
